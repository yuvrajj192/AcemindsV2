# ── Phase 0: database ────────────────────────────────────────────────────────
# Neon pooled connection string (use the "pooled" endpoint in the Neon console).
# For local dev, any Postgres URL works, e.g. postgres://user:pass@localhost:5432/aceminds
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooled) URL — used only by drizzle-kit migrations.
# Neon: copy the "direct" endpoint. Local: can equal DATABASE_URL.
DIRECT_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Phase 1: admin auth ──────────────────────────────────────────────────────
# 32+ random hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Later phases (fill in when those phases land) ────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# RESEND_API_KEY=
# ADMIN_ALERT_EMAIL=
# NEXT_PUBLIC_SITE_URL=https://aceminds.in
